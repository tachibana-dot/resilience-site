---
const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';

const content = isEnglish ? {
  heading: 'APPROACH',
  copy: 'Turning Local Knowledge into New Beginnings.',
  intro: [
    'Businesses that support local industries and daily life carry knowledge, skills, people, and pride built through years of work. Startups bring products and services that open new possibilities.',
    'We bring these strengths together so that local businesses can make products and services their own, create new businesses, and pass the value of technology on to the next generation.',
    'Together with schools, universities, and communities, we create places where people can use technology, learn from it, and keep it alive in the life of the region.',
  ],
  diagramSource: 'Local Knowledge × Products and Services from Startups',
  diagramNote: 'The strength of the field × possibilities for tomorrow',
  diagramBranches: [
    { number: '01', label: 'Creating New Businesses', body: 'Turning products and services into new beginnings through the strength of local communities.', change: 'Creating more places where technology is used' },
    { number: '02', label: 'Passing Technology to the Next Generation', body: 'Turning technology in use into learning, curiosity, and the next person who will carry it forward.', change: 'Empowering more people to use technology' },
  ],
  diagramCommunity: { number: '03', label: 'Keeping Technology Alive in Communities', body: 'Creating places where schools, universities, businesses, startups, and people continue to use and pass on what they have learned.', change: 'Growing people and technologies within communities' },
  diagramTarget: 'Building Communities Where Life Thrives.',
  items: [
    { number: '01', title: 'Creating New Businesses from Local Communities.', detailTitle: 'Turning the knowledge of the field and products from startups into new beginnings for everyday life.', body: 'We bring together the knowledge, skills, people, and pride cultivated by local businesses with products and services from startups. The aim is not simply to introduce a technology, but to let a local business make it its own, use it in the field, and grow it into a business that supports everyday life.', caseLabel: 'Example in Practice', caseTitle: 'Ignysia (Yamada Shokai Group)', caseBody: 'Ignysia is a corporate group that traces its origins to Yamada Shokai, founded in 1906. Carrying forward 120 years of infrastructure knowledge, field experience, and the strength of people who have supported essential services, the group is combining its local expertise with technologies and ideas from startups and academia. Its goal is to create new industries and businesses that build resilience for people and the planet.', source: 'https://www.ignysia.co.jp/news/ignite_your_story/' },
    { number: '02', title: 'Passing Technology to the Next Generation.', detailTitle: 'Turning technology in use into curiosity, understanding, and the next person who will carry it forward.', body: 'Technology becomes part of a community when people can see it, ask questions about it, and imagine their own place within its future. We connect products and services in use with learning, helping children encounter the work and ideas that support their everyday lives while helping adults rediscover the value of what they do.', caseLabel: 'Example in Practice', caseTitle: 'RUMEN Project', caseBody: 'Led by Environmental Microbiology Institute, Inc., the RUMEN Project develops a compact methane fermentation system with disaster response capabilities. At a local supermarket in Ishikawa, children and their parents observed the demonstration unit and learned how discarded vegetables and microorganisms can be used to produce energy. The class became a place where a technology for resource circulation could be seen, discussed, and passed into the hands of the next generation.', source: 'https://lne.st/2025/03/31/rumen3-2/', relatedLabel: 'Environmental Microbiology Institute', relatedTitle: 'Eco Stand Alone Project', relatedSource: 'https://emi-methane.com/project/' },
    { number: '03', title: 'Keeping Technology Alive in Communities.', detailTitle: 'Turning one introduction into the knowledge, relationships, and next challenges that keep a community moving.', body: 'A technology does not become part of a community through a single introduction. It takes people who use it, people who teach it, and people who carry its value into the next activity. Together with schools, universities, businesses, startups, and local people, we create the relationships through which learning, use, and new challenges can continue across generations.', caseLabel: 'Example in Practice', caseTitle: 'Tohoku Regional Revitalization Project', caseBody: 'Beginning after the Great East Japan Earthquake, science education was developed in Tohoku from 2012 with local schools, universities, and companies. The work expanded into research support and entrepreneurship support, building a network through which the next generation’s challenges could be nurtured within the region. This way of growing people and possibilities locally can also be seen in Tohoku Tech Planter today.', source: 'https://lne.st/2019/03/11/tohoku2019/', relatedLabel: 'Related link', relatedTitle: 'Tohoku Tech Planter', relatedSource: 'https://techplanter.lne.st/tohoku/' },
  ],
} : {
  heading: 'APPROACH',
  copy: '技術を、地域の力で、未来の暮らしへ。',
  intro: [
    '地域の産業と暮らしを支えてきた企業には、長い時間をかけて培われた知識、技術、人、そして誇りがあります。ベンチャーには、これからの社会を支える製品やサービスがあります。',
    '私たちは、両者をつなぎます。新しい製品やサービスを地域に持ち込むだけではありません。地域の企業が自らの現場に合わせて活用し、自分たちの事業として育てていく。そのプロセスを、ともにつくります。',
    '人が技術を使い、学び、次の人へと受け渡していく。その積み重ねによって、技術が地域の暮らしと産業の中で生き続けることを目指します。',
  ],
  diagramSource: '地域の現場にある知識 × ベンチャーの製品・サービス',
  diagramNote: '受け継いできた力 × これからの可能性',
  diagramBranches: [
    { number: '01', label: '事業をつくる', body: '地域の力で、製品・サービスを事業にする。', change: '新しい始まりを灯す' },
    { number: '02', label: '技術を渡す', body: '技術を、次の世代の手に渡す。', change: '技術を使う人を育てる' },
  ],
  diagramCommunity: { number: '03', label: '地域で続ける', body: '技術が使われ、学ばれ、次の挑戦へ受け継がれる地域の仕組みをつくる。', change: '人と技術が育ち続ける' },
  diagramTarget: '人が生き、続くまちをつくる。',
  items: [
    { number: '01', title: '地域の力で、製品・サービスを事業にする。', detailTitle: '現場の知識と、これからの技術を、次の暮らしの力に。', body: '地域の産業と暮らしを支えてきた企業には、現場、顧客、設備、人材、長年の知恵があります。ベンチャーの製品・サービスをその現場に合わせて活用し、地域企業が自らの事業として育てていくプロセスを、ともにつくります。', caseLabel: '実践例', caseTitle: '株式会社イグニシア', caseBody: '株式会社イグニシアは、エネルギー、インフラ・メンテナンス、農林水産、住環境の領域で、国内外のベンチャーやアカデミアの科学技術と自らの現場力を掛け合わせ、人と地球のレジリエンスを実現する新たな産業と事業の創出を目指しています。', source: 'https://www.ignysia.co.jp/news/ignite_your_story/' },
    { number: '02', title: '技術を、次の世代の手に渡す。', detailTitle: '使われている技術を、好奇心と未来を考える学びに。', body: '技術は、使う人と出会ってはじめて地域の力になります。実際に使われている製品・サービスを学びの場につなぎ、子どもたちが技術を見て、触れて、問いを持てる機会をつくります。関わる大人も自分たちの仕事を語り直し、その価値を再発見します。', caseLabel: '実践例', caseTitle: 'RUMENプロジェクト', caseBody: '環境微生物研究所株式会社が主体となって進めるRUMENプロジェクトは、災害対応機能を備えた小型メタン発酵システムを開発しています。石川県の地元スーパーでは、小学生親子が実証第一号機を見学し、廃棄される野菜くずと微生物の働きからエネルギーが生まれる仕組みを学ぶ実験教室を開催しました。技術が専門家だけのものではなく、地域の子どもたちが知り、語れるものになるための一歩です。', source: 'https://lne.st/2025/03/31/rumen3-2/', relatedLabel: '環境微生物研究所株式会社', relatedTitle: 'Eco Stand Alone事業', relatedSource: 'https://emi-methane.com/project/' },
    { number: '03', title: '技術が使われ続ける地域の仕組みをつくる。', detailTitle: '一度の導入を、地域の記憶と次の挑戦へ。', body: '技術を地域に根づかせるには、使う人、教える人、次に担う人が必要です。学校・大学、企業、ベンチャー、地域の人々と協力し、学びと実践が一度きりで終わらず、次の世代や次の事業へ受け継がれていく関係をつくります。', caseLabel: '実践例', caseTitle: '東北地域活性化プロジェクト', caseBody: '東日本大震災をきっかけに、2012年から東北で科学教育を展開。地域の学校、大学、企業と協力し、研究応援や創業応援へと活動を広げてきました。この活動で構築されたネットワークと次世代の挑戦を地域で育むという考え方は、現在の東北テックプランターにも通じています。', source: 'https://lne.st/2019/03/11/tohoku2019/', relatedLabel: '関連リンク', relatedTitle: '東北テックプランター', relatedSource: 'https://techplanter.lne.st/tohoku/' },
  ],
};
---

<section class="approach section-light" id="approach">
  <div class="section-inner">
    <div class="section-heading"><h2><strong><span>A</span>{content.heading.slice(1)}</strong></h2></div>
    <div class="approach-intro">
      <h3>{content.copy}</h3>
      {content.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="approach-diagram" aria-label={isEnglish ? 'Three approaches connecting local knowledge and startup products with new businesses, the next generation, and lasting communities' : '地域の知識とベンチャーの製品・サービスを、事業、次の世代、地域で続く仕組みへ'}>
      <div class="approach-source"><strong>{content.diagramSource}</strong><span>{content.diagramNote}</span></div>
      <div class="approach-branches">
        {content.diagramBranches.map((branch) => <div class="approach-branch"><span>APPROACH {branch.number}｜{branch.label}</span><strong>{branch.body}</strong><small>{isEnglish ? 'Change we want to create:' : '生み出したい変化：'}<b>{branch.change}</b></small></div>)}
      </div>
      <div class="approach-community"><span>APPROACH {content.diagramCommunity.number}｜{content.diagramCommunity.label}</span><strong>{content.diagramCommunity.body}</strong><small>{isEnglish ? 'Change we want to create:' : '生み出したい変化：'}<b>{content.diagramCommunity.change}</b></small></div>
      <div class="approach-target"><strong>{content.diagramTarget}</strong></div>
    </div>

    <div class="approach-details">
      {content.items.map((item) => <article class="approach-detail">
        <p class="approach-number">APPROACH {item.number}</p>
        <h3>{item.title}</h3>
        <h4>{item.detailTitle}</h4>
        <p>{item.body}</p>
        <div class="approach-case">
          <p class="approach-case-label">{item.caseLabel}</p>
          <h5>{item.caseTitle}</h5>
          <p>{item.caseBody}</p>
          <a href={item.source} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Learn more about the project' : '取り組みを詳しく見る'}</a>
          {item.relatedSource && <a class="approach-related-link" href={item.relatedSource} target="_blank" rel="noopener noreferrer">{item.relatedLabel}: {item.relatedTitle}</a>}
        </div>
      </article>)}
    </div>
  </div>
</section>

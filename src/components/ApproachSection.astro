---
const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';

const content = isEnglish ? {
  heading: 'APPROACH',
  copy: 'Empowering People to Use Technology. Creating Places Where Technology Makes a Difference.',
  intro: [
    'Local businesses have cultivated knowledge and skills through their work, while startups are developing advanced technologies.',
    'We bring these strengths together to create new businesses and pass technology on to the next generation.',
    'Together with schools, universities, and local communities, we nurture systems in which education, research, and business development continue within the community.',
  ],
  diagramSource: 'Local Businesses × Startups',
  diagramNote: 'Local knowledge and skills × advanced technologies',
  diagramBranches: [
    { number: '01', label: 'Creating New Businesses', body: 'Combining technologies to create new businesses from local settings.', change: 'Creating more places where technology is used' },
    { number: '02', label: 'Developing New Learning Opportunities', body: 'Turning our technologies into learning and thinking together with children.', change: 'Empowering more people to use technology' },
  ],
  diagramCommunity: { number: '03', label: 'Building Lasting Systems within Communities', body: 'Creating systems in which schools, universities, local businesses, and startups continue to participate, connecting education, research, and business development.', change: 'Growing people and technologies within communities' },
  diagramTarget: 'Building Communities Where Life Thrives.',
  items: [
    { number: '01', title: 'Creating New Businesses from Local Communities.', detailTitle: 'Turning Local Knowledge and Advanced Technologies into Businesses that Support Everyday Life.', body: 'We combine the technologies and skills cultivated by local businesses with advanced technologies from startups. By bringing together their strengths and testing, refining, and applying them in local settings, we create new businesses.', caseLabel: 'Example in Practice', caseTitle: 'Ignysia (Yamada Shokai Group)', caseBody: 'Ignysia is a new business initiative from the Yamada Shokai Group, a local company that has supported infrastructure over many years. Building on the company’s experience in the field, the initiative works together with startups and researchers to explore new business domains and develop services that can contribute to the communities where they are needed. It is an example of how local knowledge can be connected with new technologies and translated into practical opportunities for the future.', source: 'https://www.ignysia.co.jp/' },
    { number: '02', title: 'Creating New Learning from Technology.', detailTitle: 'Turning Our Technologies into Curiosity for Children.', body: 'Local businesses and startups bring their technologies together to create hands-on science programs. These programs share the excitement of technology with children while helping the adults involved rediscover the value and possibilities of their own work.', caseLabel: 'Example in Practice', caseTitle: 'RUMEN Project', caseBody: 'The RUMEN Project develops a compact methane fermentation system with disaster response capabilities. At a local supermarket in Ishikawa, an experimental class invited elementary school children and their parents to observe the first demonstration unit and explore how microorganisms can help produce energy from discarded vegetables. By connecting a real community facility with hands-on learning, the program introduced children to resource circulation, energy, and the possibilities of technology that can support everyday life and emergencies.', source: 'https://lne.st/2025/03/31/rumen3-2/' },
    { number: '03', title: 'Growing Systems that Create the Future within Communities.', detailTitle: 'Making Education Development and Business Development Lasting Parts of Local Communities.', body: 'We expand business and education development together with schools, universities, and local people. Children encounter technology, take on research, and create new businesses with local companies. We build systems in which these activities continue across generations.', caseLabel: 'Example in Practice', caseTitle: 'Tohoku Regional Revitalization Project', caseBody: 'Beginning after the Great East Japan Earthquake, science education was developed in Tohoku from 2012 with local schools, universities, and companies. The work expanded to developing research talent and supporting entrepreneurship. The idea of nurturing the next generation’s challenges within the region can also be seen in Tohoku Tech Planter today.', source: 'https://lne.st/2019/03/11/tohoku2019/', relatedLabel: 'Related link', relatedTitle: 'Tohoku Tech Planter', relatedSource: 'https://techplanter.lne.st/tohoku/' },
  ],
} : {
  heading: 'APPROACH',
  copy: '技術を使う人を増やし、技術が生きる場所を増やす。',
  intro: [
    '地域企業が培ってきた知識や技能と、ベンチャーの先端技術。',
    '私たちは、これらを組み合わせ、新しい事業をつくることと、次の世代に技術を伝えることを、ともに進めます。',
    'さらに学校や大学、地域の人々と協力し、教育・研究・事業開発が地域の中で続いていく仕組みを育てます。',
  ],
  diagramSource: '地域の事業会社 × ベンチャー',
  diagramNote: '現場の知識・技能 × 先端技術',
  diagramBranches: [
    { number: '01', label: '事業をつくる', body: '技術を組み合わせ、地域の現場から新しい事業を生み出す。', change: '技術が使われる場所を増やす' },
    { number: '02', label: '教育をつくる', body: '自分たちの技術を学びに変え、子どもたちとともに未来を考える。', change: '技術を使う人を増やす' },
  ],
  diagramCommunity: { number: '03', label: '地域の仕組みにする', body: '学校・大学・地域企業・ベンチャーが関わり続け、教育・研究・事業開発が循環する仕組みをつくる。', change: '地域に人と技術が育ち続ける' },
  diagramTarget: '人が生き、続くまちをつくる。',
  items: [
    { number: '01', title: '地域から、新しい事業をつくる。', detailTitle: '現場の知識と先端技術を、暮らしを支える新しい事業に。', body: '地域の事業会社が培ってきた技術や技能と、ベンチャーの先端技術を組み合わせる。それぞれの強みを持ち寄り、地域の現場で試し、磨きながら、新しい事業を生み出します。', caseLabel: '実践例', caseTitle: 'イグニシア（山田商会グループ）', caseBody: 'イグニシアは、長年インフラを支えてきた山田商会グループから生まれた新たな事業の取り組みです。地域企業が現場で培ってきた知識や経験を土台に、ベンチャーや研究者と協力しながら、新しい事業領域や地域に必要とされるサービスの可能性を探っています。地域に根ざした知識と新しい技術をつなぎ、これからの暮らしを支える実践的な事業へと展開していく事例です。', source: 'https://www.ignysia.co.jp/' },
    { number: '02', title: '技術から、新しい学びをつくる。', detailTitle: '自分たちの技術を、子どもたちの好奇心に変える。', body: '地域の事業会社とベンチャーが、互いの技術を持ち寄り、実験教室をつくります。子どもたちに技術の面白さを伝えるとともに、関わる大人も自分たちの技術の価値や可能性を再発見します。', caseLabel: '実践例', caseTitle: 'RUMENプロジェクト', caseBody: 'RUMENプロジェクトは、災害対応機能を備えた小型メタン発酵システムの開発を進めています。石川県の地元スーパーでは、実証第一号機を小学生親子が見学できる実験教室を開催し、廃棄される野菜くずと微生物の働きからエネルギーが生まれる仕組みを学びました。地域の施設を学びの場にすることで、資源循環やエネルギー、平時と災害時の暮らしを支える技術の可能性を、子どもたちが身近に考える機会をつくっています。', source: 'https://lne.st/2025/03/31/rumen3-2/' },
    { number: '03', title: '地域に、未来をつくる仕組みを育てる。', detailTitle: '教育開発と事業開発を、地域に根づく活動へ。', body: '事業開発と教育開発の取り組みを、学校・大学や地域の人々とともに広げていきます。子どもたちが技術に出会い、研究に挑み、地域の企業と新しい事業を生み出す。そんな活動が世代を越えて続く仕組みをつくります。', caseLabel: '実践例', caseTitle: '東北地域活性化プロジェクト', caseBody: '東日本大震災をきっかけに、2012年から東北で科学教育を展開。地域の学校、大学、企業と協力し、研究人材の育成や創業支援へと活動を広げてきました。次世代の挑戦を地域で育むという考え方は、現在の東北テックプランターにも通じています。', source: 'https://lne.st/2019/03/11/tohoku2019/', relatedLabel: '関連リンク', relatedTitle: '東北テックプランター', relatedSource: 'https://techplanter.lne.st/tohoku/' },
  ],
};
---

<section class="approach section-light" id="approach">
  <div class="section-inner">
    <div class="section-heading"><h2><strong><span>A</span>{content.heading.slice(1)}</strong></h2></div>
    <div class="approach-intro">
      <h3>{content.copy}</h3>
      {content.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="approach-diagram" aria-label={isEnglish ? 'Two parallel approaches from local businesses and startups to lasting systems within communities' : '地域の事業会社とベンチャーから、地域に根づく仕組みへ'}>
      <div class="approach-source"><strong>{content.diagramSource}</strong><span>{content.diagramNote}</span></div>
      <div class="approach-branches">
        {content.diagramBranches.map((branch) => <div class="approach-branch"><span>APPROACH {branch.number}｜{branch.label}</span><strong>{branch.body}</strong><small>{isEnglish ? 'Change we want to create:' : '生み出したい変化：'}<b>{branch.change}</b></small></div>)}
      </div>
      <div class="approach-community"><span>APPROACH {content.diagramCommunity.number}｜{content.diagramCommunity.label}</span><strong>{content.diagramCommunity.body}</strong><small>{isEnglish ? 'Change we want to create:' : '生み出したい変化：'}<b>{content.diagramCommunity.change}</b></small></div>
      <div class="approach-target"><strong>{content.diagramTarget}</strong></div>
    </div>

    <div class="approach-details">
      {content.items.map((item) => <article class="approach-detail">
        <p class="approach-number">APPROACH {item.number}</p>
        <h3>{item.title}</h3>
        <h4>{item.detailTitle}</h4>
        <p>{item.body}</p>
        <div class="approach-case">
          <p class="approach-case-label">{item.caseLabel}</p>
          <h5>{item.caseTitle}</h5>
          <p>{item.caseBody}</p>
          <a href={item.source} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Learn more about the project' : '取り組みを詳しく見る'}</a>
          {item.relatedSource && <a class="approach-related-link" href={item.relatedSource} target="_blank" rel="noopener noreferrer">{item.relatedLabel}: {item.relatedTitle}</a>}
        </div>
      </article>)}
    </div>
  </div>
</section>

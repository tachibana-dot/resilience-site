---
const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';

const content = isEnglish ? {
  heading: 'APPROACH',
  copy: 'Empowering People to Use Technology. Creating Places Where Technology Makes a Difference.',
  intro: [
    'Communities are home to knowledge and skills developed over generations, alongside emerging technologies that open up new possibilities.',
    'We value both. By bringing people together to learn, experiment, and put technology into practice, we aim to nurture new industries and ways of living.',
  ],
  diagramSource: 'Local Knowledge & Expertise × Advanced Startup Technologies',
  diagramTarget: 'Building Communities Where Life Thrives.',
  diagramNote: 'Empowering people, advancing industries, and making technologies part of everyday life.',
  closing: ['Industries endure. Knowledge is passed on. People grow to shape the future.', 'Building Communities Where Life Thrives.'],
  items: [
    { number: '01', label: 'INDUSTRY', title: 'Passing Industries on to Future Generations.', detailTitle: 'Bringing Local Expertise and Advanced Technologies Together to Create New Industries.', body: 'We bring together the experience and expertise of local businesses with new ideas and technologies from startups. By building on local resources and real-world needs, we work to develop new systems that support everyday life.', diagram: 'New Standards & Businesses', caseLabel: 'Example in Practice', caseTitle: 'RUMEN Project in Ishikawa', caseBody: 'The RUMEN Project is developing a small methane fermentation system with disaster-response capabilities. The first demonstration system was installed at a local supermarket, where discarded vegetables are used to produce gas and electricity. The project combines resource circulation, local business, and distributed energy for everyday life and emergencies.', photo: '/images/approach/rumen.png', source: 'https://lne.st/2025/03/31/rumen3-2/', credit: 'Photo: Leave a Nest / RUMEN Project' },
    { number: '02', label: 'COMPANIES & CHILDREN', title: 'Passing Technology on to Future Generations.', detailTitle: "Turning Business Technologies into Opportunities for Children to Learn.", body: "Technologies developed by businesses can spark curiosity in the next generation. By sharing their expertise through hands-on learning, engineers help children discover the excitement of technology while finding new ways to pass on and develop their knowledge.", diagram: 'Hands-on Science Education', caseLabel: 'Example in Practice', caseTitle: 'Challenergy × Miraikan', caseBody: 'Leave a Nest and the National Museum of Emerging Science and Innovation (Miraikan) created a hands-on workshop with Challenergy. Using wind-power technology as a starting point, middle and high school students explored the Magnus effect, real-world challenges, and how research and development can contribute to society.', photo: '/images/approach/challenergy-miraikan.png', source: 'https://lne.st/2020/10/28/real-tech-future-ws-01/', credit: 'Photo: Leave a Nest / Real Tech Future Workshop', supplementLabel: 'Additional example', supplementTitle: 'Kawasaki Heavy Industries × Elementary Schools in Tohoku', supplementBody: 'After the Great East Japan Earthquake, Kawasaki Heavy Industries and Leave a Nest held helicopter-making workshops at elementary schools in Tohoku, using engineering to support learning and recovery.', supplementSource: 'https://lne.st/2012/11/27/121026kawasakijyuukou/' },
    { number: '03', label: 'SCHOOLS & UNIVERSITIES', title: 'Building the Future of Communities with the Next Generation.', detailTitle: 'Making Schools and Universities Places to Learn, Research, and Take Action.', body: 'Schools and universities can be more than places to acquire knowledge. By bringing together businesses, researchers, and students to explore local challenges, we aim to empower people to shape the future of their own communities.', diagram: 'Education, Research & Field Demonstrations', caseLabel: 'Example in Practice', caseTitle: 'Tohoku Education Support Project', caseBody: 'After the Great East Japan Earthquake, the Tohoku Education Support Project worked with companies, researchers, schools, and universities. Activities expanded from hands-on science education to research talent development, support for local managers, and startup creation.', photo: '/images/approach/tohoku.png', source: 'https://lne.st/2017/03/22/touhoku2017/', credit: 'Photo: Leave a Nest / Tohoku Education Support Project', supplementLabel: 'Additional example', supplementTitle: 'Takata High School / Tohoku Bio Education Project', supplementBody: 'Students and researchers explored microorganisms in soil affected by salt damage, considering a research theme connected to the regeneration of Takada-Matsubara. This was developed as a research plan and educational inquiry, not presented as a completed outcome.', supplementSource: 'https://lne.st/2012/10/10/tohokuedu120927/' },
  ],
} : {
  heading: 'APPROACH',
  copy: '技術を使う人を増やし、技術が生きる場所を増やす。',
  intro: [
    '地域には、長い時間をかけて培われてきた知識や技能があります。そして、新しい可能性を切り拓く先端技術があります。',
    '私たちは、その両方を大切にしながら、人と人が学び合い、技術を使い、新しい産業や暮らしを育てる活動を広げていきます。',
  ],
  diagramSource: '地域企業の知識・技能 × ベンチャーの先端技術',
  diagramTarget: '人が生き、続くまちをつくる。',
  diagramNote: '産業と人が育ち、技術が使われ続ける地域へ。',
  closing: ['産業が続く。技術が受け継がれる。未来をつくる人が育つ。', '人が生き、続くまちをつくる。'],
  items: [
    { number: '01', label: '産業', title: '産業を、次の世代へ。', detailTitle: '現場の知識と先端技術から、新しい産業を育てる。', body: '地域企業が積み重ねてきた経験や技術に、ベンチャーの新しい発想や技術を重ねる。地域の資源を活かし、暮らしを支える新しい仕組みを、実際の現場から生み出していきます。', diagram: '新しいスタンダード・事業', caseLabel: '実践例', caseTitle: '石川県・RUMENプロジェクト', caseBody: '環境微生物研究所などと連携し、スーパーマーケットに小型メタン発酵装置を設置。食品廃棄物からガスと電気を生み出す仕組みの実証を進めています。平時の資源循環と災害時のエネルギー供給を、地域の現場からつなぐ取り組みです。', photo: '/images/approach/rumen.png', source: 'https://lne.st/2025/03/31/rumen3-2/', credit: '写真：リバネス／RUMENプロジェクト' },
    { number: '02', label: '企業と子ども', title: '技術を、次の世代へ。', detailTitle: '企業の技術を、子どもたちの学びに変える。', body: '企業の技術には、次の世代の好奇心を動かす力があります。技術者自身がその面白さを伝え、子どもたちとともに学ぶことで、技術を受け継ぎ、さらに発展させる人を育てます。', diagram: '実験教室・技術の継承', caseLabel: '実践例', caseTitle: 'チャレナジー × 日本科学未来館', caseBody: 'チャレナジーの風力発電技術を題材に、マグナス力の原理や社会課題の解決に向けた研究開発を学ぶ、中高生向けワークショップを企画しました。技術者と子どもたちが、技術の可能性をともに考える機会です。', photo: '/images/approach/challenergy-miraikan.png', source: 'https://lne.st/2020/10/28/real-tech-future-ws-01/', credit: '写真：リバネス／リアルテックフューチャーワークショップ', supplementLabel: '補足事例', supplementTitle: '川崎重工業 × 東北の小学校', supplementBody: '東日本大震災後、東北の小学校で企業の技術を活用したヘリコプター工作教室を実施しました。', supplementSource: 'https://lne.st/2012/11/27/121026kawasakijyuukou/' },
    { number: '03', label: '学校・大学', title: '地域の未来を、次の世代と。', detailTitle: '学校・大学を、地域の未来を考え、実践する場所にする。', body: '学校や大学を、知識を学ぶだけでなく、地域の課題に向き合う場所にする。企業、研究者、子どもたちがともに考え、実験し、挑戦することで、地域の未来を自分たちの手でつくる人を増やします。', diagram: '教育・研究・地域実証', caseLabel: '実践例', caseTitle: '東北教育応援プロジェクト', caseBody: '東日本大震災後の東北で、企業や研究者などと協力しながら実験教室や研究活動を展開。教育を起点に、研究人材育成や地域の経営者応援、創業支援へと活動を広げました。', photo: '/images/approach/tohoku.png', source: 'https://lne.st/2017/03/22/touhoku2017/', credit: '写真：リバネス／東北教育応援プロジェクト', supplementLabel: '補足事例', supplementTitle: '高田高校・東北バイオ教育プロジェクト', supplementBody: '震災や塩害を受けた地域の微生物を調査し、高田松原の再生につなげる研究テーマを検討しました。これは研究計画・教育活動の段階の事例であり、実施済みの成果とは区別して紹介しています。', supplementSource: 'https://lne.st/2012/10/10/tohokuedu120927/' },
  ],
};
---

<section class="approach section-light" id="approach">
  <div class="section-inner">
    <div class="section-heading"><h2><strong><span>A</span>{content.heading.slice(1)}</strong></h2></div>
    <div class="approach-intro">
      <h3>{content.copy}</h3>
      {content.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <!-- The concept diagram is intentionally kept unchanged. -->
    <div class="approach-diagram" aria-label={isEnglish ? 'Three approaches from local knowledge to thriving communities' : '地域の知識と技術から、まちの未来へつながる3つのアプローチ'}>
      <div class="approach-source">{content.diagramSource}</div>
      <div class="approach-branches">
        {content.items.map((item) => <div class="approach-branch"><span>{item.number} | {item.label}</span><strong>{item.diagram}</strong></div>)}
      </div>
      <div class="approach-target"><strong>{content.diagramTarget}</strong><span>{content.diagramNote}</span></div>
    </div>

    <div class="approach-details">
      {content.items.map((item) => <article class="approach-detail">
        <p class="approach-number">APPROACH {item.number}</p>
        <h3>{item.title}</h3>
        <h4>{item.detailTitle}</h4>
        <p>{item.body}</p>
        <div class="approach-case">
          <p class="approach-case-label">{item.caseLabel}</p>
          <div class="approach-case-media"><img src={item.photo} alt={item.caseTitle} loading="lazy" /><small>{item.credit}</small></div>
          <h5>{item.caseTitle}</h5>
          <p>{item.caseBody}</p>
          <a href={item.source} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Read the official article ↗' : '公式記事を読む ↗'}</a>
        </div>
        {item.supplementTitle && <div class="approach-supplement"><p class="approach-case-label">{item.supplementLabel}</p><h5>{item.supplementTitle}</h5><p>{item.supplementBody}</p><a href={item.supplementSource} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Read the source article ↗' : '参照記事を読む ↗'}</a></div>}
      </article>)}
    </div>

    <div class="approach-closing"><strong>{content.closing[0]}</strong><span>{content.closing[1]}</span></div>
  </div>
</section>

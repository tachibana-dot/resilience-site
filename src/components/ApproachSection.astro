---
const { lang = 'ja' } = Astro.props;
const isEnglish = lang === 'en';

const content = isEnglish ? {
  heading: 'APPROACH',
  copy: 'Empowering People to Use Products and Services. Creating Places Where Technology Makes a Difference.',
  intro: [
    'Businesses that support local industries and daily life have cultivated knowledge and skills through their work, while startups have brought technologies to market as products and services.',
    'We bring these strengths together to put products and services into practice, turn them into businesses, and pass the experience of using technology on to the next generation.',
    'Together with schools, universities, and local communities, we nurture systems in which learning, use, and business continue within the community.',
  ],
  diagramSource: 'Businesses Supporting Local Industries & Daily Life × Startup Products & Services',
  diagramNote: 'Local knowledge and skills × technologies brought to market',
  diagramBranches: [
    { number: '01', label: 'Creating New Businesses', body: 'Turning products and services into businesses through the strength of local communities.', change: 'Creating more places where technology is used' },
    { number: '02', label: 'Developing New Learning Opportunities', body: 'Turning products and services in use into learning and thinking together with children.', change: 'Empowering more people to use technology' },
  ],
  diagramCommunity: { number: '03', label: 'Building Lasting Systems within Communities', body: 'Creating systems in which schools, universities, local businesses, and startups continue to participate, connecting education, research, and business development.', change: 'Growing people and technologies within communities' },
  diagramTarget: 'Building Communities Where Life Thrives.',
  items: [
    { number: '01', title: 'Creating New Businesses from Local Communities.', detailTitle: 'Turning Local Knowledge and Advanced Technologies into Businesses that Support Everyday Life.', body: 'We combine the technologies and skills cultivated by local businesses with advanced technologies from startups. By bringing together their strengths and testing, refining, and applying them in local settings, we create new businesses.', caseLabel: 'Example in Practice', caseTitle: 'Ignysia (Yamada Shokai Group)', caseBody: 'Ignysia is a corporate group that traces its origins to Yamada Shokai, founded in 1906. In 2026, at the turning point of its 120th anniversary, the group changed its name to Ignysia and set out to carry its infrastructure knowledge, field presence in the Tokai region, and the strength of the people who have supported essential infrastructure into its next chapter. By combining this accumulated expertise with science and technologies from startups and academia, Ignysia aims to become a group that creates new industries and builds resilience for people and the planet across energy, infrastructure maintenance, agriculture and fisheries, and living environments.', source: 'https://www.ignysia.co.jp/news/ignite_your_story/' },
    { number: '02', title: 'Creating New Learning from Technology.', detailTitle: 'Turning Our Technologies into Curiosity for Children.', body: 'Local businesses and startups bring their technologies together to create hands-on science programs. These programs share the excitement of technology with children while helping the adults involved rediscover the value and possibilities of their own work.', caseLabel: 'Example in Practice', caseTitle: 'RUMEN Project', caseBody: 'Led by Environmental Microbiology Institute, Inc., the RUMEN Project develops a compact methane fermentation system with disaster response capabilities. At a local supermarket in Ishikawa, children and their parents observed the demonstration unit and learned how discarded vegetables and microorganisms can be used to produce energy for everyday life and emergencies.', source: 'https://lne.st/2025/03/31/rumen3-2/', relatedLabel: 'Environmental Microbiology Institute', relatedTitle: 'Eco Stand Alone Project', relatedSource: 'https://emi-methane.com/project/' },
    { number: '03', title: 'Growing Systems that Create the Future within Communities.', detailTitle: 'Making Education Development and Business Development Lasting Parts of Local Communities.', body: 'We expand business and education development together with schools, universities, and local people. Children encounter technology, take on research, and create new businesses with local companies. We build systems in which these activities continue across generations.', caseLabel: 'Example in Practice', caseTitle: 'Tohoku Regional Revitalization Project', caseBody: 'Beginning after the Great East Japan Earthquake, science education was developed in Tohoku from 2012 with local schools, universities, and companies. The work expanded to developing research talent and supporting entrepreneurship. The idea of nurturing the next generation’s challenges within the region can also be seen in Tohoku Tech Planter today.', source: 'https://lne.st/2019/03/11/tohoku2019/', relatedLabel: 'Related link', relatedTitle: 'Tohoku Tech Planter', relatedSource: 'https://techplanter.lne.st/tohoku/' },
  ],
} : {
  heading: 'APPROACH',
  copy: '製品・サービスを使う人を増やし、技術が生きる場所を増やす。',
  intro: [
    '地域の産業と暮らしを支えてきた企業の知識・技術と、製品やサービスとして形になったベンチャーの技術。',
    '私たちは、これらを組み合わせ、地域の力で製品・サービスを事業にすることと、次の世代に技術を伝えることを、ともに進めます。',
    'さらに学校や大学、地域の人々と協力し、製品・サービスが地域で使われ続ける仕組みを育てます。',
  ],
  diagramSource: '地域の産業と暮らしを支える企業 × ベンチャーの製品・サービス',
  diagramNote: '現場の知識・技術 × 実用化された技術',
  diagramBranches: [
    { number: '01', label: '事業をつくる', body: '地域の力で、製品・サービスを事業にする。', change: '技術が使われる場所を増やす' },
    { number: '02', label: '教育をつくる', body: '使われている技術を学びに変え、子どもたちとともに未来を考える。', change: '技術を使う人を増やす' },
  ],
  diagramCommunity: { number: '03', label: '地域で使い続ける', body: '学校・大学・企業・ベンチャーが関わり続け、製品・サービスが地域で使われ続ける仕組みをつくる。', change: '地域に人と技術が育ち続ける' },
  diagramTarget: '人が生き、続くまちをつくる。',
  items: [
    { number: '01', title: '地域の力で、製品・サービスを事業にする。', detailTitle: '地域の知識・技術と、製品・サービスを暮らしを支える事業に。', body: '地域の産業と暮らしを支えてきた企業の知識・技術と、ベンチャーの製品・サービスを組み合わせる。それぞれの強みを持ち寄り、地域の現場で活用しながら、事業として使い続けられる形をつくります。', caseLabel: '実践例', caseTitle: '株式会社イグニシア', caseBody: '株式会社イグニシアは、エネルギー、インフラ・メンテナンス、農林水産、住環境の領域で、国内外のベンチャーやアカデミアの科学技術と自らの現場力を掛け合わせ、人と地球のレジリエンスを実現する新たな産業と事業の創出を目指しています。', source: 'https://www.ignysia.co.jp/news/ignite_your_story/' },
    { number: '02', title: '使われている技術から、新しい学びをつくる。', detailTitle: '自分たちの技術を、子どもたちの好奇心に変える。', body: '地域の企業とベンチャーが、実際に使われている製品・サービスを学びの場につなげます。子どもたちに技術の面白さを伝えるとともに、関わる大人も自分たちの仕事や技術の価値を再発見します。', caseLabel: '実践例', caseTitle: 'RUMENプロジェクト', caseBody: '環境微生物研究所株式会社が主体となって進めるRUMENプロジェクトは、災害対応機能を備えた小型メタン発酵システムを開発しています。石川県の地元スーパーでは、小学生親子が実証第一号機を見学し、廃棄される野菜くずと微生物の働きからエネルギーが生まれる仕組みを学ぶ実験教室を開催しました。', source: 'https://lne.st/2025/03/31/rumen3-2/', relatedLabel: '環境微生物研究所株式会社', relatedTitle: 'Eco Stand Alone事業', relatedSource: 'https://emi-methane.com/project/' },
    { number: '03', title: '技術が使われ続ける地域の仕組みをつくる。', detailTitle: '教育開発と事業開発を、地域に根づく活動へ。', body: '学校・大学、企業、ベンチャー、地域の人々と協力し、製品・サービスが地域の中で使われ続ける仕組みをつくります。子どもたちが技術に出会い、地域の企業が活用し、次の担い手へと経験が受け継がれていく活動を目指します。', caseLabel: '実践例', caseTitle: '東北地域活性化プロジェクト', caseBody: '東日本大震災をきっかけに、2012年から東北で科学教育を展開。地域の学校、大学、企業と協力し、研究応援や創業応援へと活動を広げてきました。この活動で構築されたネットワークと次世代の挑戦を地域で育むという考え方は、現在の東北テックプランターにも通じています。', source: 'https://lne.st/2019/03/11/tohoku2019/', relatedLabel: '関連リンク', relatedTitle: '東北テックプランター', relatedSource: 'https://techplanter.lne.st/tohoku/' },
  ],
};
---

<section class="approach section-light" id="approach">
  <div class="section-inner">
    <div class="section-heading"><h2><strong><span>A</span>{content.heading.slice(1)}</strong></h2></div>
    <div class="approach-intro">
      <h3>{content.copy}</h3>
      {content.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="approach-diagram" aria-label={isEnglish ? 'Two parallel approaches from local businesses and startups to lasting systems within communities' : '地域の事業会社とベンチャーから、地域に根づく仕組みへ'}>
      <div class="approach-source"><strong>{content.diagramSource}</strong><span>{content.diagramNote}</span></div>
      <div class="approach-branches">
        {content.diagramBranches.map((branch) => <div class="approach-branch"><span>APPROACH {branch.number}｜{branch.label}</span><strong>{branch.body}</strong><small>{isEnglish ? 'Change we want to create:' : '生み出したい変化：'}<b>{branch.change}</b></small></div>)}
      </div>
      <div class="approach-community"><span>APPROACH {content.diagramCommunity.number}｜{content.diagramCommunity.label}</span><strong>{content.diagramCommunity.body}</strong><small>{isEnglish ? 'Change we want to create:' : '生み出したい変化：'}<b>{content.diagramCommunity.change}</b></small></div>
      <div class="approach-target"><strong>{content.diagramTarget}</strong></div>
    </div>

    <div class="approach-details">
      {content.items.map((item) => <article class="approach-detail">
        <p class="approach-number">APPROACH {item.number}</p>
        <h3>{item.title}</h3>
        <h4>{item.detailTitle}</h4>
        <p>{item.body}</p>
        <div class="approach-case">
          <p class="approach-case-label">{item.caseLabel}</p>
          <h5>{item.caseTitle}</h5>
          <p>{item.caseBody}</p>
          <a href={item.source} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Learn more about the project' : '取り組みを詳しく見る'}</a>
          {item.relatedSource && <a class="approach-related-link" href={item.relatedSource} target="_blank" rel="noopener noreferrer">{item.relatedLabel}: {item.relatedTitle}</a>}
        </div>
      </article>)}
    </div>
  </div>
</section>

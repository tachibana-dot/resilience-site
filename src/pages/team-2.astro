---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
const entry = (await getCollection('pages')).find((item) => item.data.language === 'ja' && item.data.slug === 'team-2');
const { Content } = await render(entry);
---
<BaseLayout title="チームからのメッセージ | LVNS RESILIENCE PROJECT">
  <Header />
  <main class="team-page">
    <div class="section-inner">
      <SectionHeading letter="T" rest="EAM" sub="チームからのメッセージ" />
      <div class="team-source-content prose"><Content /></div>
    </div>
  </main>
  <Footer />
</BaseLayout>

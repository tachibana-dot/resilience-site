---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({ params: { page: entry.data.language === 'en' ? `en/${entry.data.slug}` : entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} | LVNS RESILIENCE PROJECT`}><Header /><main class="legacy-page"><div class="article-inner"><p class="eyebrow">{entry.data.language === 'en' ? 'LVNS RESILIENCE PROJECT' : 'リバネス・レジリエンス・プロジェクト'}</p><h1>{entry.data.title}</h1><div class="prose legacy-content"><Content /></div></div></main><Footer /></BaseLayout>

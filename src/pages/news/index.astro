---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="News | LVNS RESILIENCE PROJECT"><Header /><main class="listing-page"><div class="section-inner"><p class="eyebrow">LVNS RESILIENCE PROJECT</p><h1>News</h1><div class="news-grid">{news.map((item) => <article class="news-card"><a href={`/news/${item.id}/`}><figure>{item.data.image && <img src={item.data.image} alt="" loading="lazy" />}</figure><div class="news-body"><h2>{item.data.title}</h2><div class="news-meta"><time>{item.data.date.toLocaleDateString('ja-JP')}</time><span>{item.data.category}</span></div></div></a></article>)}</div></div></main><Footer /></BaseLayout>

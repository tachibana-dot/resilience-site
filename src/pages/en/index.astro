---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ApproachSection from '../../components/ApproachSection.astro';
import { ecosystemCompanies, ecosystemProducts } from '../../data/ecosystem';

const news = (await getCollection('news')).filter((item) => item.data.language === 'en').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const solutions = [
  ['Disaster Management', 'disaster.png', 'solution1'], ['Architecture', 'architecture.png', 'solution2'],
  ['Electricity, Gas & Water', 'utilities.png', 'solution3'], ['Transport & Mobility', 'transport.png', 'solution4'],
  ['Community', 'community.png', 'solution5'], ['Healthcare & Medicine', 'healthcare.png', 'solution6'],
];
const roleLabels: Record<string, string> = { 'ソリューション提供企業': 'Solution provider', '関連ベンチャー': 'Related venture', '参画ベンチャー': 'Project venture' };
const descriptions: Record<string, string> = {
  '株式会社人機一体': 'Develops remote-operation technology for humanoid heavy machinery and robots used in infrastructure maintenance and disaster response.',
  '株式会社ナチュラニクス': 'Builds energy and mobility services around fast-charging, long-life batteries and portable storage for disaster response.',
  '株式会社Sydecas': 'A food-tech company creating new forms of food from konjac-derived materials, including lower-sugar and lower-fat alternatives.',
  '株式会社Aster': 'Develops Aster Power Coating, a paint-on seismic reinforcement material for existing walls and block fences.',
  '環境微生物研究所株式会社': 'Uses microorganisms to convert waste vegetables and other materials into methane, electricity and liquid fertilizer.',
  '株式会社vitom': 'Optimizes starch formulation and heating conditions to make reliable food for everyday life and emergencies.',
  '株式会社Planetary Wellness': 'Combines mental and physical condition forecasting with local places of connection to help build a society free from loneliness and isolation.',
  '株式会社ＡＣＳＬ': 'Uses Japanese-made drones for disaster damage assessment and delivery of relief supplies to isolated communities.',
  '株式会社天地人': 'Visualizes water-pipe leakage risks with satellite data and supports sustainable water infrastructure management.',
  '株式会社チャレナジー': 'Develops small wind turbines that generate power even in strong winds and turbulent conditions, supporting resilient energy supply.',
  '株式会社e6s（えしっくす）': 'Develops a water-circulation toilet system that remains usable even when electricity and water infrastructure is disrupted.',
  'NT技研工業株式会社': 'Supports distributed energy systems with a concentrated solar system that generates both electricity and hot water.',
  '株式会社白獅子': 'Uses VR to recreate disaster and medical training scenarios, helping people prepare for emergencies.',
  '株式会社Liberaware': 'Uses small industrial drones to inspect narrow, dark and dangerous spaces, making infrastructure maintenance safer and more efficient during both normal operations and disasters.',
  '株式会社サグリ': 'Uses satellite imagery, AI and geospatial data to visualize disaster damage and support information on a map for faster response.',
  'WOTA株式会社': 'Uses small-scale distributed water-circulation systems to provide water and sanitation support such as bathing and hand-washing during disasters.',
  '株式会社Ridge-i': 'Uses satellite-image analysis and AI to assess environmental and disaster risks such as landslides.',
  '株式会社テラ・ラボ': 'Uses fixed-wing unmanned aircraft and wide-area sensing to support rapid situational awareness and information gathering during disasters and recovery.',
};
const categoryLabel = (category: string) => category === 'ニュース' ? 'News' : category;
const englishProductTitles: Record<string, string> = {
  pf4: 'Landslide and Road Collapse Survey with the PF4 Multi-use Drone',
  soten: 'Earthquake Damage Assessment with the SOTEN Compact Aerial Drone',
  airtruck: 'Disaster Logistics with the AirTruck Delivery Drone',
  tenchijin: 'Water Infrastructure DX with Tenchijin Compass',
  challenergy: 'Small Wind Turbines for Disaster Resilience',
  e6s: 'Infrastructure-independent Water-circulation Toilet System',
  ntgiken: 'Compact Tower Concentrated Solar Power System',
  snowlion: 'VR Solutions for Disaster Experience and Medical Training',
  planetarywellness: 'Toward a Society Free from Loneliness',
};
---
<BaseLayout title="LVNS RESILIENCE PROJECT | English" description="Creating resilient and tolerant social infrastructure with deep technology.">
  <Header />
  <main class="english-home">
    <section class="hero concept-hero" aria-label="LVNS Resilience Project">
      <div class="hero-copy"><p class="hero-name">LVNS RESILIENCE PROJECT</p><p class="hero-org">Organized by <span>Leave a Nest</span></p><h1 class="hero-title">Building Communities Where Life Thrives.</h1><p class="hero-tagline">by deep technology<br />for future generations</p></div>
      <div class="hero-visual"><img src="/images/hero/tokyo-skytree-panorama.png" alt="Tokyo cityscape seen from Tokyo Skytree" loading="eager" /><a class="hero-credit" href="https://commons.wikimedia.org/wiki/File:Panoramic_view_of_Tokyo_from_the_Tokyo_Skytree.png" target="_blank" rel="noreferrer">Photo: Harrison Kuo / Wikimedia Commons (CC BY 4.0)</a></div>
    </section>

    <section class="vision section-dark" id="vision"><div class="section-inner vision-inner"><SectionHeading letter="V" rest="ISION" /><div class="vision-copy"><p class="vision-brand">Built on the Living Earth.</p><h3>Building Communities Where Life Thrives.</h3><p>Our daily lives are supported by the knowledge, skills, and dedication of people in local communities.<br /><br />Today, population decline, aging infrastructure, natural disasters, and environmental challenges are transforming the foundations of how we live.<br /><br />Across Japan, local businesses and communities have accumulated generations of practical knowledge and expertise. At the same time, products and services built on emerging technologies are opening up new possibilities.<br /><br />For us, resilience means more than preparing for disasters. It means sustaining people’s lives and local industries through change.<br /><br />The LVNS Resilience Project works with businesses that support local industries and daily life, as well as schools, universities, and communities, to put products and services from startups into practice and sustain their use.<br /><br />By advancing local industries, creating opportunities for people to learn and apply technology, and turning ideas into real-world solutions, we aim to build communities where people can thrive today and for generations to come.<br /><br />Starting in Japan, we seek to contribute to the well-being of the planet and society.</p></div></div></section>

    <ApproachSection lang="en" />

    <section class="news-section section-light" id="news"><div class="section-inner"><SectionHeading letter="N" rest="EWS" sub="Latest news from the LVNS Resilience Project" /><div class="news-grid">{news.slice(0, 8).map((item) => <article class="news-card"><a href={`/en/${item.data.slug ?? item.id}/`}><figure><img src={item.data.image ?? '/images/noimg.jpg'} alt="" loading="lazy" /></figure><div class="news-body"><h3>{item.data.title}</h3><div class="news-meta"><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('en-US')}</time><span>{categoryLabel(item.data.category)}</span></div></div></a></article>)}</div><a class="outline-button" href="/en/news/">View all news</a></div></section>

    <section class="ecosystem section-light" id="ecosystem"><div class="section-inner"><SectionHeading letter="E" rest="COSYSTEM" sub="Ventures and companies connected to the Resilience Project" /><p class="ecosystem-intro">Guided by the L VENTURES philosophy, we introduce technologies and services from ventures tackling social challenges through a resilience lens.</p><div class="ecosystem-grid">{ecosystemCompanies.map((company) => <article class="ecosystem-card"><div class="ecosystem-card-image"><img src={company.image} alt={`${company.name} image`} loading="lazy" /></div><div class="ecosystem-card-body"><p class="ecosystem-role">{roleLabels[company.role] ?? company.role}</p><h3>{company.name}</h3>{descriptions[company.name] && <p class="ecosystem-description">{descriptions[company.name]}</p>}<div class="ecosystem-products">{ecosystemProducts(company.productSlugs).map((product) => <a href={`/en/solution/${product!.slug}/`}>View solution: {englishProductTitles[product!.slug] ?? product!.title}</a>)}</div><div class="ecosystem-links">{company.ventureUrl && <a class="ecosystem-external" href={company.ventureUrl} target="_blank" rel="noreferrer">View on L VENTURES ↗</a>}{company.website && <a class="ecosystem-external" href={company.website} target="_blank" rel="noreferrer">Company website ↗</a>}</div></div></article>)}</div></div></section>

    <section class="solutions section-light" id="solutions"><div class="section-inner"><SectionHeading letter="B" rest="USINESS SOLUTION" sub="Business Solutions" /><p class="solutions-intro">Explore products and services from the ventures in the ECOSYSTEM, organized by field.</p><div class="solution-grid">{solutions.map(([name, image, slug]) => <a class="solution-card" href={`/en/solution_cat/${slug}/`}><figure><img src={`/images/solutions/${image}`} alt={name} loading="lazy" /></figure><span>{name}</span></a>)}</div></div></section>

    <section class="contact section-dark" id="contact"><div class="section-inner contact-inner"><SectionHeading letter="C" rest="ONTACT" sub="Contact" /><p>For inquiries about the project, please contact us by email.</p><a class="contact-button" href="mailto:info@lne.st">Contact by email</a></div></section>
  </main>
  <Footer />
</BaseLayout>

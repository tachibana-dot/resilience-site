---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { products, getCategory } from '../../data/solutions';
export async function getStaticPaths() {
  const entries = await getCollection('solutions');
  return entries.filter((entry) => entry.data.language === 'ja').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, product: products.find((item) => item.slug === entry.data.slug) },
  }));
}
const { entry, product } = Astro.props;
const { Content } = await render(entry);
const categories = product?.categories ?? [];
---
<BaseLayout title={`${product.title} | LVNS RESILIENCE PROJECT`}>
  <Header />
  <main class="listing-page product-page">
    <div class="article-inner">
      <p class="eyebrow">BUSINESS SOLUTION</p>
      <p class="breadcrumb"><a href="/">HOME</a><span>›</span>{categories.map((slug) => <a href={`/solution_cat/${slug}/`}>{getCategory(slug)?.title}</a>)}</p>
      <h1>{entry.data.title}</h1>
      <section class="product-copy prose solution-source-content"><Content /></section>
      {categories[0] && <a class="back-link" href={`/solution_cat/${categories[0]}/`}>← ソリューション一覧へ</a>}
    </div>
  </main>
  <Footer />
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ApproachSection from '../components/ApproachSection.astro';
import { ecosystemCompanies, ecosystemProducts } from '../data/ecosystem';

const news = (await getCollection('news')).filter((item) => item.data.language === 'ja').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Keep the partner section in the source so it can be restored by changing this to true.
const showPartners = false;
const solutions = [
  ['災害マネジメント', 'disaster.png', 'solution1'], ['建築', 'architecture.png', 'solution2'],
  ['電気、ガス、水道', 'utilities.png', 'solution3'], ['交通、輸送', 'transport.png', 'solution4'],
  ['コミュニティ', 'community.png', 'solution5'], ['ヘルスケア・医療', 'healthcare.png', 'solution6'],
];
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero" aria-label="LVNS Resilience Project">
      <div class="hero-copy"><p class="hero-name">LVNS RESILIENCE PROJECT</p><p class="hero-org">Organized by <span>Leave a Nest</span></p><p class="hero-tagline">by deep technology<br />for future generations</p></div>
      <div class="hero-slider" aria-hidden="true">
        {['a','b','c','d','e','f','g','h'].map((letter) => <img src={`/images/hero/fv${letter}.jpg`} alt="" loading={letter === 'a' ? 'eager' : 'lazy'} />)}
      </div>
    </section>

    <section class="vision section-dark" id="vision"><div class="section-inner vision-inner"><SectionHeading letter="V" rest="ISION" /><div class="vision-copy"><h3>人が生き、続くまちをつくる。</h3><p>私たちの暮らしは、多くの人々の知識と技術によって支えられています。<br /><br />しかし、人口減少、社会インフラの老朽化、自然災害などによって、これまでの暮らしを支える仕組みは大きな転換点を迎えています。<br /><br />日本各地には、長い時間をかけて培われてきた知識や技術があります。そして、社会のあり方を変える可能性を持つ新しいテクノロジーも次々と生まれています。<br /><br />リバネスは、これらを組み合わせ、地域の人々とともに新しい暮らしと産業をつくります。<br /><br />平時の豊かさと、変化に対応できる強さを兼ね備えたまちを、日本から世界へ。<br /><br />次の世代が、自分たちの未来に希望と誇りを持てる社会を目指します。</p></div></div></section>

    <ApproachSection lang="ja" />

    <section class="news-section section-light" id="news"><div class="section-inner"><SectionHeading letter="N" rest="EWS" sub="リバネス・レジリエンス・プロジェクトの最新情報" /><div class="news-grid">{news.slice(0, 8).map((item) => <article class="news-card"><a href={`/${item.data.slug ?? item.id}/`}><figure><img src={item.data.image ?? '/images/noimg.jpg'} alt="" loading="lazy" /></figure><div class="news-body"><h3>{item.data.title}</h3><div class="news-meta"><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('ja-JP')}</time><span>{item.data.category}</span></div></div></a></article>)}</div><a class="outline-button" href="/news/">ニュース一覧</a></div></section>

    <section class="ecosystem section-light" id="ecosystem"><div class="section-inner"><SectionHeading letter="E" rest="COSYSTEM" sub="レジリエンスプロジェクトに関係するベンチャー・企業" /><p class="ecosystem-intro">社会インフラのしなやかさを支える技術やサービスを、ソリューションとして紹介しています。</p><div class="ecosystem-grid">{ecosystemCompanies.map((company) => <article class="ecosystem-card"><div class="ecosystem-card-image"><img src={company.image} alt={`${company.name}のイメージ`} loading="lazy" /></div><div class="ecosystem-card-body"><p class="ecosystem-role">{company.role}</p><h3>{company.name}</h3>{company.description && <p class="ecosystem-description">{company.description}</p>}<div class="ecosystem-products">{ecosystemProducts(company.productSlugs).map((product) => <a href={`/solution/${product!.slug}/`}>{product!.title}</a>)}</div><div class="ecosystem-links">{company.ventureUrl && <a class="ecosystem-external" href={company.ventureUrl} target="_blank" rel="noreferrer">L VENTURESで詳しく見る ↗</a>}{company.website && <a class="ecosystem-external" href={company.website} target="_blank" rel="noreferrer">公式Webサイト ↗</a>}</div></div></article>)}</div></div></section>

    <section class="solutions section-light" id="solutions"><div class="section-inner"><SectionHeading letter="B" rest="USINESS SOLUTION" sub="ビジネス ソリューション" /><p class="solutions-intro">ECOSYSTEMのベンチャーの製品やサービスを、分野ごとに紹介します。</p><div class="solution-grid">{solutions.map(([name, image, slug]) => <a class="solution-card" href={`/solution_cat/${slug}/`}><figure><img src={`/images/solutions/${image}`} alt="" loading="lazy" /></figure><span>{name}</span></a>)}</div></div></section>

    {showPartners && <section class="partners section-light" id="partners"><div class="section-inner"><SectionHeading letter="P" rest="ARTNER" sub="リバネス・レジリエンス・プロジェクトは、以下の企業・機関等が参加し、取り組んでいます。" /><div class="partner-panel"><div class="partner-grid" aria-label="パートナー企業"><div class="partner-logo"><img src="/images/partners/logo01.png" alt="Aqua Clara" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo02.png" alt="キヤノンマーケティングジャパン株式会社" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo03.png" alt="JR東日本" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo04.png" alt="株式会社山田商会ホールディング" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo05.png" alt="復建調査設計" loading="lazy" /></div></div><div class="organizer-logo"><p>Organized by</p><img src="/images/partners/leave-a-nest.png" alt="Leave a Nest" loading="lazy" /></div></div></div></section>}
    <section class="contact section-dark" id="contact"><div class="section-inner contact-inner"><SectionHeading letter="C" rest="ONTACT" sub="お問い合わせ" /><p>プロジェクトに関するお問い合わせは、メールフォームからご連絡ください。</p><a class="contact-button" href="mailto:info@lne.st">メールでのお問い合わせ</a></div></section>
  </main>
  <Footer />
</BaseLayout>

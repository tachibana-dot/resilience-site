---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ApproachSection from '../components/ApproachSection.astro';
import { ecosystemCompanies, ecosystemProducts } from '../data/ecosystem';

const news = (await getCollection('news')).filter((item) => item.data.language === 'ja').sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Keep the partner section in the source so it can be restored by changing this to true.
const showPartners = false;
const solutions = [
  ['災害マネジメント', 'disaster.png', 'solution1'], ['建築', 'architecture.png', 'solution2'],
  ['電気、ガス、水道', 'utilities.png', 'solution3'], ['交通、輸送', 'transport.png', 'solution4'],
  ['コミュニティ', 'community.png', 'solution5'], ['ヘルスケア・医療', 'healthcare.png', 'solution6'],
];
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero concept-hero" aria-label="LVNS Resilience Project">
      <div class="hero-copy"><p class="hero-name">LVNS RESILIENCE PROJECT</p><p class="hero-org">Organized by <span>Leave a Nest</span></p><p class="hero-brandline">Rooted in Place, Built for Tomorrow.</p><p class="hero-tagline">by deep technology<br />for future generations</p></div>
      <div class="hero-visual" aria-label="地域と都市の風景"><figure class="hero-slide hero-slide-1"><img src="/images/hero/tokyo-sunset.jpg" alt="夕暮れの東京の街並み" loading="eager" /><a class="hero-credit" href="https://unsplash.com/photos/a-view-of-a-city-with-tall-buildings-Sn2Hq_i8cm8" target="_blank" rel="noreferrer">Photo: Ong Cheng Zheng / Unsplash</a></figure><figure class="hero-slide hero-slide-2"><img src="/images/hero/miyazu-street.jpg" alt="宮津の街路" loading="lazy" /><a class="hero-credit" href="https://unsplash.com/photos/a-quiet-street-in-a-japanese-town-F7-G2mW73QE" target="_blank" rel="noreferrer">Photo: PJH / Unsplash</a></figure><figure class="hero-slide hero-slide-3"><img src="/images/hero/nagasaki-harbor.jpg" alt="長崎港と街並み" loading="lazy" /><a class="hero-credit" href="https://unsplash.com/ja/%E5%86%99%E7%9C%9F/%E9%83%BD%E5%B8%82%E3%81%AB%E5%9B%B2%E3%81%BE%E3%82%8C%E3%81%9F%E5%A4%A7%E3%81%8D%E3%81%AA%E6%B0%B4%E5%9F%9F-ERVZMxv0hQw" target="_blank" rel="noreferrer">Photo: Roméo A. / Unsplash</a></figure><figure class="hero-slide hero-slide-4"><img src="/images/hero/kobe-port.jpg" alt="神戸の街と港" loading="lazy" /><a class="hero-credit" href="https://unsplash.com/photos/aerial-view-of-city-buildings-during-daytime-kEzo7ZXhYSk" target="_blank" rel="noreferrer">Photo: Richard Tao / Unsplash</a></figure><figure class="hero-slide hero-slide-5"><img src="/images/hero/okayama-town.jpg" alt="山を背景にした岡山の街の通り" loading="lazy" /><a class="hero-credit" href="https://unsplash.com/photos/a-city-street-with-shops-and-a-mountain-in-the-background-9vqkeksYPkk" target="_blank" rel="noreferrer">Photo: SRTgraphy / Unsplash</a></figure></div>
    </section>

    <section class="vision section-dark" id="vision"><div class="section-inner vision-inner"><SectionHeading letter="V" rest="ISION" /><div class="vision-copy"><h3>人が生き、続くまちをつくる。</h3><p>私たちの暮らしは、多くの人々の知識と技術によって支えられています。<br /><br />しかし、人口減少、社会インフラの老朽化、自然災害などによって、これまでの暮らしを支える仕組みは大きな転換点を迎えています。<br /><br />日本各地には、長い時間をかけて培われてきた知識や技術があります。そして、社会のあり方を変える可能性を持つ新しいテクノロジーも次々と生まれています。<br /><br />私たちが考えるレジリエンスとは、災害に備えるだけでなく、変化の中でも人の暮らしと地域の産業を続けていく力です。<br /><br />リバネス・レジリエンス・プロジェクトでは、地域の産業と暮らしを支える企業、学校、大学、人々とともに、製品やサービスとして形になった技術を現場で活用し、新しい暮らしと産業をつくります。<br /><br />平時の豊かさと、変化に対応できる強さを兼ね備えたまちを、日本から世界へ。<br /><br />次の世代が、自分たちの未来に希望と誇りを持てる社会を目指します。</p></div></div></section>

    <section class="news-section section-light" id="news"><div class="section-inner"><SectionHeading letter="N" rest="EWS" sub="地域の現場で、人と技術の新しい関係が始まっています。" /><div class="news-grid">{news.slice(0, 8).map((item) => <article class="news-card"><a href={`/${item.data.slug ?? item.id}/`}><figure><img src={item.data.image ?? '/images/noimg.jpg'} alt="" loading="lazy" /></figure><div class="news-body"><h3>{item.data.title}</h3><div class="news-meta"><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('ja-JP')}</time><span>{item.data.category}</span></div></div></a></article>)}</div><a class="outline-button" href="/news/">ニュース一覧</a></div></section>

    <ApproachSection lang="ja" />

    <section class="solutions section-light" id="solutions"><div class="section-inner"><SectionHeading letter="B" rest="USINESS SOLUTION" sub="地域の現場で活用できる製品・サービス" /><p class="solutions-intro">地域の課題や現場に応じて活用できる、企業・ベンチャーの製品やサービスを分野ごとに紹介します。</p><div class="solution-grid">{solutions.map(([name, image, slug]) => <a class="solution-card" href={`/solution_cat/${slug}/`}><figure><img src={`/images/solutions/${image}`} alt="" loading="lazy" /></figure><span>{name}</span></a>)}</div></div></section>

    <section class="ecosystem section-light" id="ecosystem"><div class="section-inner"><SectionHeading letter="E" rest="COSYSTEM" sub="地域の未来をともにつくる企業・ベンチャー" /><p class="ecosystem-intro">地域の現場を持つ企業と、製品・サービスとして形になった技術を持つベンチャー。異なる知識と力を持つ仲間を紹介します。</p><div class="ecosystem-grid">{ecosystemCompanies.map((company) => <article class="ecosystem-card"><div class="ecosystem-card-image"><img src={company.image} alt={`${company.name}のイメージ`} loading="lazy" /></div><div class="ecosystem-card-body"><p class="ecosystem-role">{company.role}</p><h3>{company.name}</h3>{company.description && <p class="ecosystem-description">{company.description}</p>}<div class="ecosystem-products">{ecosystemProducts(company.productSlugs).map((product) => <a href={`/solution/${product!.slug}/`}>{product!.title}</a>)}</div><div class="ecosystem-links">{company.ventureUrl && <a class="ecosystem-external" href={company.ventureUrl} target="_blank" rel="noreferrer">L VENTURESで詳しく見る ↗</a>}{company.website && <a class="ecosystem-external" href={company.website} target="_blank" rel="noreferrer">公式Webサイト ↗</a>}</div></div></article>)}</div></div></section>

    {showPartners && <section class="partners section-light" id="partners"><div class="section-inner"><SectionHeading letter="P" rest="ARTNER" sub="リバネス・レジリエンス・プロジェクトは、以下の企業・機関等が参加し、取り組んでいます。" /><div class="partner-panel"><div class="partner-grid" aria-label="パートナー企業"><div class="partner-logo"><img src="/images/partners/logo01.png" alt="Aqua Clara" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo02.png" alt="キヤノンマーケティングジャパン株式会社" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo03.png" alt="JR東日本" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo04.png" alt="株式会社山田商会ホールディング" loading="lazy" /></div><div class="partner-logo"><img src="/images/partners/logo05.png" alt="復建調査設計" loading="lazy" /></div></div><div class="organizer-logo"><p>Organized by</p><img src="/images/partners/leave-a-nest.png" alt="Leave a Nest" loading="lazy" /></div></div></div></section>}
    <section class="contact section-dark" id="contact"><div class="section-inner contact-inner"><SectionHeading letter="C" rest="ONTACT" sub="地域の現場から、ともにつくる仲間へ" /><p>地域の現場を持つ企業、製品・サービスを持つベンチャー、次の世代に技術を渡したい方。プロジェクトへのお問い合わせをお待ちしています。</p><a class="contact-button" href="mailto:info@lne.st">メールでのお問い合わせ</a></div></section>
  </main>
  <Footer />
</BaseLayout>
